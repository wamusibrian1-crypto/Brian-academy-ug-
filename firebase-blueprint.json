        "term": { "type": "string", "maxLength": 60 },
        "amountUGX": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["MTN MoMo", "Airtel Money", "Bank Deposit", "Cash Receipt"] },
        "referenceCode": { "type": "string", "minLength": 1, "maxLength": 80 },
        "payerPhone": { "type": "string", "maxLength": 40 },
        "receiptUrl": { "type": "string", "maxLength": 900000 },
        "adminNote": { "type": "string", "maxLength": 400 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentId", "studentName", "classLevel", "term", "amountUGX", "paymentMethod", "referenceCode", "payerPhone", "receiptUrl", "adminNote", "status", "createdAt", "updatedAt"]
    },
    "FileUpload": {
      "title": "FileUpload",
      "description": "Metadata manifest for multi-chunk uploaded PDFs and high-resolution photos.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileName": { "type": "string", "maxLength": 200 },
        "mimeType": { "type": "string", "maxLength": 120 },
        "sizeBytes": { "type": "number" },
        "chunkCount": { "type": "number" },
        "scope": { "type": "string", "enum": ["material", "assessment", "submission", "fee", "advert"] },
        "uploadedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fileName", "mimeType", "sizeBytes", "chunkCount", "scope", "uploadedBy", "createdAt"]
    },
    "FileChunk": {
      "title": "FileChunk",
      "description": "Single base64 chunk of an uploaded PDF or photo.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "index": { "type": "number" },
        "data": { "type": "string", "maxLength": 700000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fileId", "index", "data", "createdAt"]
    },
    "PublicNotification": {
      "title": "PublicNotification",
      "description": "PII-free public platform upload and chat alert feed readable before login.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "kind": { "type": "string", "enum": ["material", "assessment", "submission", "chat", "announcement"] },
        "title": { "type": "string", "maxLength": 140 },
        "summary": { "type": "string", "maxLength": 240 },
        "subject": { "type": "string", "maxLength": 40 },
        "classLevel": { "type": "string", "enum": ["ALL", "S1", "S2", "S3", "S4", "S5", "S6"] },
        "active": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "kind", "title", "summary", "subject", "classLevel", "active", "createdBy", "createdAt"]
    },
    "HomepageConfig": {
      "title": "HomepageConfig",
      "description": "Publicly readable, administrator-editable front page content and toggles.",
      "type": "object",
      "properties": {
        "heroEyebrow": { "type": "string", "maxLength": 100 },
        "heroTitle": { "type": "string", "maxLength": 140 },
        "heroSubtitle": { "type": "string", "maxLength": 500 },
        "motto": { "type": "string", "maxLength": 160 },
        "advertsEnabled": { "type": "boolean" },
        "appDownloadEnabled": { "type": "boolean" },
        "appDownloadTitle": { "type": "string", "maxLength": 140 },
        "appDownloadDescription": { "type": "string", "maxLength": 800 },
        "androidApkUrl": { "type": "string", "maxLength": 500 },
        "admissionsEnabled": { "type": "boolean" },
        "admissionsTitle": { "type": "string", "maxLength": 160 },
        "admissionsSummary": { "type": "string", "maxLength": 1200 },
        "admissionsRequirements": { "type": "string", "maxLength": 2000 },
        "aboutBadge": { "type": "string", "maxLength": 100 },
        "aboutTitle": { "type": "string", "maxLength": 200 },
        "aboutDescription": { "type": "string", "maxLength": 1500 },
        "contactEmail": { "type": "string", "maxLength": 120 },
        "contactPhone": { "type": "string", "maxLength": 40 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["heroEyebrow", "heroTitle", "heroSubtitle", "motto", "advertsEnabled", "appDownloadEnabled", "appDownloadTitle", "appDownloadDescription", "androidApkUrl", "admissionsEnabled", "admissionsTitle", "admissionsSummary", "admissionsRequirements", "aboutBadge", "aboutTitle", "aboutDescription", "contactEmail", "contactPhone", "updatedBy", "updatedAt"]
    }
  },
